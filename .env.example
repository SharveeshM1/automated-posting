# Copy to .env and fill in the platforms you want to use.
# A platform with missing credentials is reported as "failed" (Not configured)
# and the remaining platforms are still posted to.

# Bluesky: Settings -> Privacy and security -> App passwords
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE=https://bsky.social

# Mastodon: Preferences -> Development -> New application (scope: write:statuses)
MASTODON_INSTANCE=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# DEV Community: Settings -> Extensions -> DEV Community API Keys
DEVTO_API_KEY=

# GitHub Gist: personal access token with the "gist" scope
GITHUB_TOKEN=

# GitLab: personal access token with the "api" scope from gitlab.com -> Edit profile -> Access tokens
GITLAB_TOKEN=

# Timeouts (seconds)
REQUEST_TIMEOUT_SECONDS=15
PLATFORM_TIMEOUT_SECONDS=30
